{
  "name": "regenradar-web",
  "version": "0.1.0",
  "description": "Ad-free rain radar PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "python3 tools/make-icons.py",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop",
    "screenshots": "node tools/screenshots.mjs"
  },
  "type": "module",
  "dependencies": {
    "maplibre-gl": "^6.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "private": true
}
